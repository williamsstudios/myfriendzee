<%- include('./partials/header.ejs') %>
<%- include('./partials/navbar.ejs') %>
<div class="container" style="margin-top: 68px;">
     <div class="row">
          <div class="col-lg-12">
               <%- include("./inc/messages.ejs") %>
          </div>
     </div>
     <div class="row">
          <div class="col-lg-3">
               <div class="card mt-2">
                    <h5 class="card-header bg-danger text-dark">Welcome Back, <% if(curUser.accountType == "artist") { %><%- curUser.artistName %><% } else { %><%- curUser.firstname %><% } %></h5>
                    <div class="card-body">
                         <div class="row mb-3">
                              <div class="col-lg-12">
                                   <a href="/users/profile/<%- curUser.username %>">
                                        <% if(curUser.avatar != "") { %>
                                             <img src="/uploads/<%- curUser.username %>/<%- curUser.avatar %>" width="100%" style="max-height: 500px;">
                                        <% } else { %>
                                             <img src="/img/no_pic.jpg" width="100%" style="max-height: 500px;">
                                        <% } %>
                                   </a>
                              </div>
                         </div>
                         <div class="row mb-2">
                              <div class="col text-center">
                                   <p class="m-0 p-0" style="font-size: 14px;"><b>Profile Views: </b> <%- curUser.profileViews %></p>
                                   <p class="m-0 p-0" style="font-size: 14px;"><a href="#" data-toggle="modal" data-target="#mediaUploadModal">Add A Photo/Video</a></p>
                              </div>
                         </div>
                    </div>
               </div>
               <% if(alerts.length > 0) { %>
                    <div class="card mt-3">
                         <h5 class="card-header bg-danger text-dark">Updates</h5>
                         <% for(var a = 0; a<alerts.length; a++) { %>
                              <% if(alerts[a].app == "New Post") { %>
                                   <p class="m-0 p-0" style="font-size: 14px;"><i class="fa-solid fa-envelope text-secondary"></i> New Posts</p>
                              <% } %>
                              <% if(alerts[a].app == "New Photo") { %>
                                   <p class="m-0 p-0" style="font-size: 14px;"><i class="fa-solid fa-images text-success"></i> New Photos</p>
                              <% } %>
                         <% } %>
                    </div>
               <% } %>
          </div>
     </div>
     <div class="modal fade" id="mediaUploadModal" tabindex="-1" role="dialog" aria-labelledby="mediaUploadModalLabel" aria-hidden="true">
          <div class="modal-dialog" role="document">
               <div class="modal-content">
                    <div class="modal-header">
                         <h5 class="modal-title" id="mediaUploadModalLabel"><i class="fa-solid fa-images text-success mr-2"></i> Upload A Photo Or Video</h5>
                         <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                         </button>
                    </div>
                     <div class="modal-body">
                         <form method="POST" action="/users/mediaUpload" enctype="multipart/form-data">
                              <div class="row mb-2">
                                   <div class="col">
                                        <input type="text" class="form-control" id="gallery" name="gallery" placeholder="Enter Gallery Name">
                                   </div>
                              </div>
                              <div class="row mb-2">
                                   <div class="col">
                                        <textarea class="form-control" id="caption" name="caption" placeholder="Enter A Caption"></textarea>
                                   </div>
                              </div>
                              <div class="row mb-2">
                                   <div class="col">
                                        <div class="input-group">
                                             <div class="custom-file">
                                                  <input type="file" class="custom-file-input" id="mediaItem" name="mediaItem">
                                                  <label class="custom-file-label" for="mediaItem" aria-describedby="mediaItem">Choose file</label>
                                             </div>
                                        </div>
                                   </div>
                              </div>
                              <div class="row mb-2">
                                   <div class="col">
                                        <button type="submit" class="btn btn-danger btn-md">Upload</button>
                                   </div>
                              </div>
                              <div class="row mb-2">
                                   <div class="col">
                                        <small class="text-muted">By clicking "Upload" you are agreeing that you own the rights to the media you are uploading and that it meets <a href="#">Community Standards</a></small>
                                   </div>
                              </div>
                         </form>
                     </div>
               </div>
          </div>
     </div>
</div>
<%- include('partials/footer') %>